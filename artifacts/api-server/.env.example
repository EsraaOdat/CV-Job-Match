# Copy this file to .env (same folder) and add ONE of these keys.

# Free option: Google Gemini. Get a key at https://aistudio.google.com/apikey (no billing needed)
GEMINI_API_KEY=

# Paid option: Anthropic Claude. Key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Optional settings
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER=gemini   # when both keys are set: gemini or claude
